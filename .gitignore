# ============================================================
# .gitignore - Proyecto Paisajes Sonoros Tapyta
# Solo se versionan scripts Python, documentacion y config.
# Todo lo demas (datos, figuras, modelos, binarios) se ignora.
# ============================================================

# --- Archivos de datos grandes ---
*.csv
*.parquet
*.npy
*.npz
*.pkl
*.pickle
*.h5
*.hdf5

# --- Figuras y audio ---
*.png
*.jpg
*.jpeg
*.svg
*.pdf
*.mp3
*.wav
*.wma
*.m4a
*.mp4
*.avi

# --- Archivos comprimidos ---
*.zip
*.tar.gz
*.rar
*.7z

# --- HTML y notebooks generados ---
*.html
*.ipynb

# --- Tablas de seleccion y anotaciones ---
*.txt

# --- Carpetas de datos y resultados ---
Datos/
Salida/
audio_clusters/
resultados/
resultados_HDD_Seagate/
modelos_fase2_fase4/
figuras_inspeccion_clusters/
figuras_inspeccion_subclusters/
figuras_umap_overlay/
embeddings_BD_anfibios/
embeddings_representativos/
proyeccion_BD_fase1_5/
matching_representativos_vs_base/
validacion_matching_rep_vs_base/
podcast_chunks/
selection_tables_por_cluster_anotadas/
selection_tables_por_cluster_desde_raven/

# --- Bases de datos de audio (carpetas con espacios) ---
BD_anfibios_wav/
BD anfibios/
Dendrosophus spp/

# --- Documentos con resultados (privados; GitHub solo documenta metodologia) ---
Campaña_Diciembre_2024/06_Documento_Tecnico/documento_tecnico_paisajes_sonoros.tex
Campaña_Diciembre_2024/06_Documento_Tecnico/guia_personal_paisajes_sonoros.tex
Campaña_Diciembre_2024/06_Documento_Tecnico/abstract_SOLABIMA2026_preview.tex

# --- Entornos virtuales Python ---
venv/
.venv/
env/
Papelera/

# --- Python cache ---
__pycache__/
*.pyc
*.pyo

# --- Config local / temporales sueltos ---
.claude/settings.local.json
*.tmp.*

# --- NO ignorar: scripts Python y documentacion ---
!*.py
!*.md
!CLAUDE.md
!.claude/
!.claude/settings.json